# Alcore Frontend Environment Variables

# Demo Mode
# Set to 'true' to enable demo mode (useful for presentations)
# VITE_DEMO_MODE=true

# API Configuration
# Override the default API base URL if needed
# VITE_API_BASE_URL=http://localhost:3001/api

# Backend URL for OAuth2 (used by GitHub OAuth component)
# VITE_BACKEND_URL=http://localhost:3001

# TokenPanel / API Platform base (Settings → API Platform links)
# Local TokenPanel API runs on :3000; production default is https://alcore.io.vn
# VITE_TOKENPANEL_URL=http://localhost:3000

# Auth Repo C base (todo 8 identity service; CORS triangle member)
# Local Auth binds :8082; production default is https://auth.alcore.io.vn
# VITE_AUTH_URL=http://localhost:8082

# Auth mode hint (todo 41): server-advertised system-info authMode wins;
# this only pre-selects the login notice before system-info loads.
# local (default): local sign-in forms. alcore: Auth-only notice.
# VITE_ALCORE_AUTH_MODE=local

# Auth browser handoff (canonical callback) cutover switch. Default off: the
# legacy local password form stays the only way in until the migration census
# shows users are mapped. Set to 'true' only after that cutover decision.
# VITE_AUTH_BROWSER_HANDOFF=false

# Timeout Configuration (in milliseconds)
# API timeout for frontend requests (default: 5 minutes)
# Increase this for large models on multiple GPUs that take longer to load
# VITE_API_TIMEOUT=300000

# Development
# NODE_ENV=development
