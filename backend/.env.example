PORT=3001
OLLAMA_BASE_URL=http://localhost:11434
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Database Configuration
# Source-relative paths start at backend/; ./data is backend/data.
# Existing installs that use ./backend/data continue using backend/backend/data.
DATA_DIR=./data

# Timeout Configuration (in milliseconds)
# Standard timeout for regular API calls (default: 5 minutes)
OLLAMA_TIMEOUT=300000
# Extended timeout for long operations like model loading/pulling (default: 15 minutes)
OLLAMA_LONG_OPERATION_TIMEOUT=900000

# Alcore Claw Agent Integration
# Start Alcore Claw with: alcore-claw start
# The dashboard/API defaults to http://127.0.0.1:8766/dashboard
ALCORE_CLAW_BASE_URL=http://127.0.0.1:8766
ALCORE_CLAW_TIMEOUT_MS=30000

# Authentication & User Management
SINGLE_USER_MODE=false
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
# Later registration is disabled by default; first local admin bootstrap works.
ENABLE_SIGNUP=false

# Self-hosted vs Alcore-managed auth boundary (todo 41)
# local (default): local password/OAuth/MFA/passkey routes work as today.
# alcore: local credential-issuance routes return 404 LOCAL_AUTH_DISABLED and
# the external Auth service is the only sign-in path. Product sessions already
# minted keep working; only issuing local credentials is disabled.
# Unset, empty, or unrecognized values fail closed to local.
# ALCORE_AUTH_MODE=local

# Direct Auth relying party (todo 45, Alcore mode only)
# Origin of the canonical Auth service (Repo C) for the server-to-server
# opaque-code exchange at POST /oidc/exchange/token. Libre never verifies
# passwords/OAuth itself and never holds the Auth HS256 secret (holding it
# would let Libre mint Auth sessions); authenticity comes from the S2S TLS
# exchange, plus structural iss/aud/intent/exp checks.
# ALCORE_AUTH_URL=https://auth.alcore.io.vn
# Expected `iss` of Auth assertions. Must match Auth AUTH_ISSUER exactly.
# ALCORE_AUTH_ISSUER=https://auth.alcore.io.vn

# TokenPanel single-login bridge (Settings → API Platform)
# API base of the TokenPanel deployment to link against.
# TOKENPANEL_API_URL=https://alcore.io.vn
# Management key (tp_mgmt_*, customers:read+customers:write) authorizing the
# server-side portal-token mint. Never expose to the browser; never commit.
# TOKENPANEL_MGMT_KEY=
# The keys/projects BFF (routes/tokenpanel.ts, Wave4 todo 19) reuses the same
# two variables: it resolves the caller server-side and mints a short-lived
# customer grant per request. No additional env is needed.
# The auto base-usage hook (services/apiPlatformProvisionService.ts, todo 19
# flowfix) mints a per-user platform key through that BFF and stores it as
# the user's encrypted `alcore` plugin credential (server-side only). Chat
# reaches the hosted platform on the manifest default; an operator-held
# ALCORE_API_KEY is only a fallback for local single-user setups.
# ALCORE_API_KEY=

# Single Sign-On (SSO) Configuration
# GitHub OAuth2 Configuration
# Create OAuth app at: https://github.com/settings/developers
# Set callback URL to: http://localhost:3001/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=your_github_client_id_here
# GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Hugging Face OAuth2 Configuration  
# Create OAuth app at: https://huggingface.co/settings/applications
# Set callback URL to: http://localhost:3001/api/auth/oauth/huggingface/callback
# HUGGINGFACE_CLIENT_ID=your_huggingface_client_id_here
# HUGGINGFACE_CLIENT_SECRET=your_huggingface_client_secret_here

# Generic OIDC Configuration (any OpenID Connect provider with discovery)
# Set callback URL to: http://localhost:3001/api/auth/oauth/oidc/callback
# OIDC_ISSUER_URL=https://id.example.com/realms/main
# OIDC_CLIENT_ID=alcore
# OIDC_CLIENT_SECRET=your_oidc_client_secret_here
# OIDC_DISPLAY_NAME=Single Sign-On
# OIDC_SCOPES=openid profile email
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# OIDC_GROUP_CLAIM=groups
# OIDC_ADMIN_GROUPS=alcore-admins
# OIDC_SYNC_GROUPS=false

# Security audit log retention (days)
# AUDIT_RETENTION_DAYS=180

# Cloudflare Turnstile Signup Protection (optional)
# Create a widget at: https://dash.cloudflare.com/?to=/:account/turnstile
# When both values are set, Create Account and first-time admin setup require Turnstile verification.
# TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Session Configuration
# SESSION_SECRET=your_session_secret_here

# Database Encryption
# 64-character encryption key for protecting sensitive data at rest
# If omitted on a fresh store, one is generated at DATA_DIR/.encryption_key.
# ENCRYPTION_KEY=

# Plugin API Keys
# Add your API keys here for external AI services
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# GITHUB_API_KEY=
# OPENROUTER_API_KEY=
# KIMI_API_KEY=

# Text-to-Speech (TTS) API Keys
# ElevenLabs - Get API key at: https://elevenlabs.io
# ELEVENLABS_API_KEY=

# Work runtime (enabled by default in repository Compose files)
# Group that owns the host Docker socket, as seen INSIDE a container. Docker
# Desktop uses 0; a Linux host uses its docker group. Read it with:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
#     alpine stat -c '%g' /var/run/docker.sock
# DOCKER_GID=0
# Host path of the Docker socket to mount into the container.
# DOCKER_SOCKET=/var/run/docker.sock
